+bool Sampler::is_finite_row(const float* data, size_t size) {
+    // A float is NaN or +/-Inf iff its exponent bits are all ones. Branch-free OR reduction (auto-vectorized).
+    uint32_t non_finite = 0;
+    for (size_t i = 0; i < size; ++i) {
+        uint32_t bits;
+        std::memcpy(&bits, data + i, sizeof(bits));
+        non_finite |= static_cast<uint32_t>((bits & 0x7f800000u) == 0x7f800000u);
+    }
+    return non_finite == 0;
