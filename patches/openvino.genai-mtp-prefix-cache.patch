+        const size_t rolling_capacity = get_rolling_snapshot_capacity();
+        if (!shared && rolling_capacity == 0) {
+            return {};
+        }
+        const bool value_policy = !shared && rolling_capacity >= 3;
+
+        // Conversation lineages currently in the store (rolling snapshots only).
+        struct LineageInfo {
+            size_t depth = 0;
+            uint64_t last_request = 0;
+            size_t count = 0;
+            bool established = false;
+            bool has_candidate = false;
+            std::list<LinearAttentionSnapshot>::iterator candidate;  // its least recently used unpinned snapshot
+        };
+        std::map<uint64_t, LineageInfo> lineages;
+        size_t num_rolling = 0;
+        for (auto it = m_la_snapshots.begin(); it != m_la_snapshots.end(); ++it) {
+            if (it->kind == LinearAttentionSnapshotKind::SHARED) {
+                continue;
+            }
+            ++num_rolling;
+            auto& info = lineages[it->lineage];
+            info.depth = std::max(info.depth, it->num_tokens);
+            info.last_request = std::max(info.last_request, it->last_request);
+            info.established |= it->established;
+            ++info.count;
+            if (it->pins == 0 && (!info.has_candidate || it->last_use < info.candidate->last_use)) {
+                info.has_candidate = true;
+                info.candidate = it;
+            }
+        }
+
+        // Value-based policy (3+ rolling slots), step 1: a conversation never holds more than
+        // max(2, rolling_capacity / 2) snapshots (its newest end-of-prompt and generation snapshots), free rows or
+        // not, so that another conversation always finds room.
+        const uint64_t lineage = shared ? 0 : get_snapshot_lineage_unlocked(seq_id);
+        const auto own = lineages.find(lineage);
+        if (value_policy) {
+            const size_t per_lineage_capacity = std::max<size_t>(2, rolling_capacity / 2);
+            if (own != lineages.end() && own->second.count >= per_lineage_capacity && own->second.has_candidate) {
+                return take(own->second.candidate);
+            }
+        }
+        if (m_la_snapshots.size() < m_la_snapshot_capacity && (shared || num_rolling < rolling_capacity)) {
+            BlocksPerLayer row = la_block_mgr.allocate_detached_block();
+            if (!row.empty()) {
+                return row;
+            }
+        }
+
+        if (!value_policy) {
+            // Legacy policy: least recently used unpinned rolling snapshot.
+            auto victim = m_la_snapshots.end();
+            for (auto it = m_la_snapshots.begin(); it != m_la_snapshots.end(); ++it) {
+                if (it->pins != 0 || it->kind == LinearAttentionSnapshotKind::SHARED) {
+                    continue;
+                }
+                if (victim == m_la_snapshots.end() || it->last_use < victim->last_use) {
+                    victim = it;
+                }
+            }
+            if (victim == m_la_snapshots.end()) {
+                return {};
+            }
+            return take(victim);
+        }
+
+        // Step 2: pick the lineage that gives up its oldest snapshot. Classes, cheapest loss first:
+        //   0. stale lineages (not used within the last LA_SNAPSHOT_RECENT_REQUESTS requests), oldest first;
+        //   1. one-shot lineages (never continued by a later request: title / tag / follow-up generation, a chat
+        //      that had a single round), shallowest first: such requests recycle each other's slots;
+        //   2. established conversations (continued at least once), least recently used first, but only for a
+        //      capture of at least LA_SNAPSHOT_MIN_DISPLACING_TOKENS tokens: a new real conversation displaces
+        //      the oldest one, a short unrelated request never does (it then goes without a snapshot).
+        auto victim = lineages.end();
+        int victim_class = 3;
+        const auto better = [&](const LineageInfo& candidate, int candidate_class) {
+            if (candidate_class != victim_class) {
+                return candidate_class < victim_class;
+            }
+            if (candidate_class == 1 && candidate.depth != victim->second.depth) {
+                return candidate.depth < victim->second.depth;
+            }
+            return candidate.last_request < victim->second.last_request;
+        };
+        for (auto it = lineages.begin(); it != lineages.end(); ++it) {
+            if (it->first == lineage || !it->second.has_candidate) {
+                continue;
+            }
+            int candidate_class = 2;
+            if (m_la_request_clock - it->second.last_request > LA_SNAPSHOT_RECENT_REQUESTS) {
+                candidate_class = 0;
+            } else if (!it->second.established) {
+                candidate_class = 1;
+            } else if (new_tokens < LA_SNAPSHOT_MIN_DISPLACING_TOKENS) {
+                continue;
+            }
+            if (victim == lineages.end() || better(it->second, candidate_class)) {
+                victim = it;
+                victim_class = candidate_class;
+            }
+        }
+        if (victim != lineages.end()) {
+            return take(victim->second.candidate);
+        }
+        // Nothing to take from the others: replace our own older snapshot (the new one is deeper), if any.
+        if (own != lineages.end() && own->second.has_candidate) {
+            return take(own->second.candidate);
+        }
+        return {};
+    }
+
+    void restore_with_linear_attention_snapshot(const SequenceGroup::Ptr& sequence_group, size_t max_processed_tokens) {
+        std::lock_guard<std::mutex> lock(m_la_snapshot_mutex);
+        if (m_la_snapshots.empty() && m_la_shared_prefix_min_tokens == 0) {
+            return;
+        }
+        const auto sequences = sequence_group->get_not_finished_sequences();
+        OPENVINO_ASSERT(sequences.size() == 1);
+        const auto& sequence = sequences[0];
+        const uint64_t seq_id = sequence->get_id();
+        const size_t prompt_len = sequence_group->get_prompt_len();
+        if (prompt_len < 2 || sequence_group->get_num_processed_tokens() != 0) {
+            return;
+        }
+        auto& kv_block_mgr = *m_block_managers.at(CacheType::KV_CACHE);
+        auto& la_block_mgr = *m_block_managers.at(CacheType::LINEAR_ATTENTION_CACHE);
+
+        // 1. How much of the prompt is covered by cached KV blocks (strictly inside the prompt)?
+        const size_t limit = std::min(prompt_len - 1, max_processed_tokens);
+        if (limit == 0) {
+            return;
+        }
+        const auto kv_coverage = kv_block_mgr.get_prefix_restore_plan(sequence_group, limit);
+        if (kv_coverage.empty()) {
+            return;
+        }
+
+        // 2. Deepest snapshot that lies inside the KV coverage and matches this prompt's prefix.
+        auto best = m_la_snapshots.end();
+        for (auto it = m_la_snapshots.begin(); it != m_la_snapshots.end(); ++it) {
+            if (it->num_tokens == 0 || it->num_tokens > kv_coverage.cache_token_position) {
+                continue;
+            }
+            if (best != m_la_snapshots.end() && it->num_tokens <= best->num_tokens) {
+                continue;
+            }
+            if (sequence->get_hash(it->num_tokens, m_la_snapshot_kv_block_size) == it->hash) {
+                best = it;
+            }
+        }
+        GENAI_INFO("LA prefix snapshot: request %llu prompt %zu: KV prefix cache covers %zu tokens (limit %zu), "
+                   "deepest matching snapshot %zu, %zu stored",
+                   static_cast<unsigned long long>(sequence_group->get_request_id()), prompt_len,
+                   kv_coverage.cache_token_position, limit, best == m_la_snapshots.end() ? size_t(0) : best->num_tokens,
+                   m_la_snapshots.size());
+        // Shared-prefix learning: no conversation-specific snapshot matches this prompt (a new conversation),
+        // yet the KV prefix cache already holds much more of it than the best snapshot covers. Ask the
+        // prefill to end a chunk at the end of that cached prefix and to snapshot it for the next conversation.
+        // (Only when NO snapshot matches: if the anchor itself matches, this is a conversation running on the anchor
+        // alone and the anchor must stay where the stable preamble ends.)
+        if (m_la_shared_prefix_min_tokens > 0 && best == m_la_snapshots.end()) {
+            const size_t covered = (kv_coverage.cache_token_position / m_la_snapshot_kv_block_size) * m_la_snapshot_kv_block_size;
+            const size_t best_position = 0;
+            if (covered >= best_position + m_la_shared_prefix_min_tokens && covered < prompt_len) {
+                m_la_shared_prefix_targets[seq_id] = covered;
+                GENAI_INFO("LA prefix snapshot: shared prefix of %zu tokens detected (request %llu, best snapshot %zu)",
+                           covered, static_cast<unsigned long long>(sequence_group->get_request_id()), best_position);
+            }
+        }
+        if (best == m_la_snapshots.end()) {
+            return;
+        }
+        const size_t position = best->num_tokens;
+        const auto kv_plan = kv_block_mgr.get_prefix_restore_plan(sequence_group, position);
+        if (kv_plan.empty() || kv_plan.cache_token_position != position || kv_plan.processed_tokens != position) {
+            return;
+        }
+
+        // 3. KV blocks of [0, position); this also sets processed tokens to `position`.
+        //    No LA row is allocated here (this runs on the add_request thread): the committed row is allocated
+        //    by the scheduler when the sequence is first scheduled, and the pending copy below targets it then.
+        const size_t la_rows_before = la_block_mgr.get_total_block_count();
+        if (!kv_block_mgr.restore_cached_blocks(sequence_group, kv_plan)) {
+            return;
+        }
+        OPENVINO_ASSERT(la_block_mgr.get_total_block_count() == la_rows_before,
+                        "LA snapshot restore must not grow the linear-attention pool");
+        OPENVINO_ASSERT(sequence_group->get_num_processed_tokens() == position,
+                        "LA snapshot restore: unexpected processed token count ",
+                        sequence_group->get_num_processed_tokens(), ", expected ", position);
+
+        // 4. snapshot -> committed row, applied by allocate_cache_if_needed() once the sequence owns a row,
+        //    i.e. in the scheduling pass that schedules its first chunk, before that forward. The snapshot is
+        //    pinned until then so that it is neither evicted nor overwritten.
+        best->pins++;
+        best->last_use = ++m_la_snapshot_clock;
+        // The request continues the conversation of the snapshot it restarts from (a shared-prefix anchor
+        // belongs to no conversation); the whole lineage counts as used by this request.
+        const uint64_t own_lineage = get_snapshot_lineage_unlocked(seq_id);
+        if (best->kind != LinearAttentionSnapshotKind::SHARED) {
+            m_la_sequence_lineage[seq_id] = best->lineage;
+            m_la_established_sequences.insert(seq_id);
+            for (auto& snapshot : m_la_snapshots) {
+                if (snapshot.lineage == best->lineage && snapshot.kind != LinearAttentionSnapshotKind::SHARED) {
+                    snapshot.last_request = m_la_request_clock;
+                    snapshot.established = true;
+                }
+            }
+        } else {
+            (void)own_lineage;
+            best->last_request = m_la_request_clock;
+        }
+        m_la_restore_base[seq_id] = position;
+        m_la_pending_restores[seq_id] = PendingLinearAttentionRestore{best};
+        ++m_la_snapshot_stats.num_restored_requests;
+        m_la_snapshot_stats.num_restored_tokens += position;
+        GENAI_INFO("LA prefix snapshot: restored %zu of %zu prompt tokens (request %llu, from row %d)",
+                   position, prompt_len, static_cast<unsigned long long>(sequence_group->get_request_id()),
+                   best->row.front()->get_index());
+    }
+
+    void apply_pending_linear_attention_snapshot_restores() {
+        std::lock_guard<std::mutex> lock(m_la_snapshot_mutex);
+        if (m_la_pending_restores.empty()) {
+            return;
+        }
+        auto& la_block_mgr = *m_block_managers.at(CacheType::LINEAR_ATTENTION_CACHE);
+        std::map<size_t, std::list<size_t>> copy_map;
+        for (auto it = m_la_pending_restores.begin(); it != m_la_pending_restores.end();) {
+            const uint64_t seq_id = it->first;
+            if (!la_block_mgr.has_block_table(seq_id)) {
+                ++it;  // not scheduled yet: no committed row (and no forward) so far
+                continue;
+            }
+            const size_t dst_row = get_linear_attention_live_block(seq_id);
+            copy_map[static_cast<size_t>(it->second.snapshot->row.front()->get_index())].push_back(dst_row);
+            OPENVINO_ASSERT(it->second.snapshot->pins > 0);
+            it->second.snapshot->pins--;
+            it = m_la_pending_restores.erase(it);
+        }
+        if (copy_map.empty()) {
+            return;
+        }
+        if (linear_attention_checks_enabled()) {
+            check_linear_attention_copy_map(copy_map);
+        }
+        m_cache_managers.at(CacheType::LINEAR_ATTENTION_CACHE)->copy_blocks(copy_map);
+    }
+
+    void forget_linear_attention_snapshot_sequence(uint64_t seq_id) {
+        if (!m_la_snapshot_mode) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(m_la_snapshot_mutex);
+        m_la_snapshot_captured_sequences.erase(seq_id);
+        m_la_shared_prefix_targets.erase(seq_id);
+        m_la_restore_base.erase(seq_id);
+        m_la_sequence_lineage.erase(seq_id);
+        m_la_established_sequences.erase(seq_id);
+        auto it = m_la_pending_restores.find(seq_id);
+        if (it != m_la_pending_restores.end()) {
+            // The sequence's row is about to be freed and possibly reused: never copy into it.
+            OPENVINO_ASSERT(it->second.snapshot->pins > 0);
+            it->second.snapshot->pins--;
+            m_la_pending_restores.erase(it);
+        }
+    }
+
+    void release_linear_attention_snapshots() {
+        std::lock_guard<std::mutex> lock(m_la_snapshot_mutex);
+        m_la_pending_restores.clear();
+        m_la_snapshot_captured_sequences.clear();
+        m_la_shared_prefix_targets.clear();
+        m_la_restore_base.clear();
+        m_la_sequence_lineage.clear();
+        m_la_established_sequences.clear();
+        const auto it = m_block_managers.find(CacheType::LINEAR_ATTENTION_CACHE);
+        if (it != m_block_managers.end()) {
+            for (const auto& snapshot : m_la_snapshots) {
+                it->second->free_detached_block(snapshot.row);
+            }
+        }
+        m_la_snapshots.clear();
+    }
