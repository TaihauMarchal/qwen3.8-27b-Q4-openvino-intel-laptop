+    }
+
+    // Runs scheduling + "forward" until the group has generated its first token; returns the chunk sizes.
+    std::vector<size_t> prefill(const SequenceGroup::Ptr& group) {
+        std::vector<SequenceGroup::Ptr> requests = {group};
+        std::vector<size_t> chunks;
+        while (group->get_num_processed_tokens() < group->get_prompt_len()) {
+            auto out = scheduler->schedule(requests);
+            EXPECT_EQ(out.m_scheduled_sequence_groups_ids.size(), 1);
+            chunks.push_back(group->get_num_scheduled_tokens());
+            group->finish_iteration();
+        }
+        return chunks;
+    }
+
+    void finish(const SequenceGroup::Ptr& group) {
+        for (auto& sequence : group->get_sequences()) {
