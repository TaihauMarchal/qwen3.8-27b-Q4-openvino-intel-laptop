+TEST(TestLinearAttentionPrefixSnapshot, generation_snapshot_follows_committed_position_and_restores_generated_prefix) {
+    SnapshotFixture probe;
+    const size_t bs = probe.kv_block_size;
+    ScopedEnv env("OV_GENAI_LA_GEN_SNAPSHOT_GRID", std::to_string(bs));
+    SnapshotFixture fixture(0, true, /*max_num_assistant_tokens=*/3);
+    const size_t grid = 2 * bs;
+    // Generation snapshots raise the default store capacity to 4 rolling snapshots.
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_preallocated_rows(), 4 + 4 + 4);
+
+    // Prompt ends 2 tokens before a KV block boundary B = 2 * grid + bs.
+    std::vector<int64_t> prompt1 = iota_tokens(2 * grid + bs - 2);
+    auto group1 = make_group(0, prompt1);
+    auto sequence1 = group1->get_running_sequences()[0];
+    const uint64_t seq1 = sequence1->get_id();
+    fixture.prefill(group1);
+    ASSERT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_captured, 1);  // end-of-prompt snapshot
+    auto& la = fixture.orchestrator->get_block_manager(CacheType::LINEAR_ATTENTION_CACHE);
+
+    // First generated token, then a verification pass over 3 draft candidates of which only the first
+    // is accepted: the pass processes [first token, c1] -> committed position prompt_len + 2 == B.
+    const std::vector<int64_t> generated = {7001, 7002, 7003, 7004};
+    for (const int64_t token : generated) {
+        sequence1->append_token(token, 0.f);
+    }
+    group1->set_num_validated_tokens(3);
+    std::vector<SequenceGroup::Ptr> requests = {group1};
+    fixture.scheduler->schedule(requests);
+    ASSERT_EQ(group1->get_num_scheduled_tokens(), 4);
+    const size_t processed_before = group1->get_num_processed_tokens();
+    ASSERT_EQ(processed_before, prompt1.size());
+    for (size_t slot = 1; slot <= 4; ++slot) {
+        const int row = la.get_temporary_block_index(seq1, slot);
+        ASSERT_GE(row, 0);
+        fixture.fill_row(static_cast<size_t>(row), static_cast<uint8_t>(0x40 + slot));  // "state after slot tokens"
+    }
+    EXPECT_EQ(la.get_temporary_block_index(seq1, 5), -1);
+    // Sampling: c2 and c3 rejected, the verifier's own token replaces c2.
+    group1->finish_iteration();
+    sequence1->remove_last_tokens(2);
+    sequence1->append_token(7102, 0.f);
+    group1->update_processed_tokens_num(processed_before + 2);
+    const size_t boundary = 2 * grid + bs;
+    ASSERT_EQ(group1->get_num_processed_tokens(), boundary);
+    fixture.scheduler->capture_linear_attention_generation_snapshot(group1, sequence1, processed_before,
+                                                                    group1->get_num_processed_tokens());
+    fixture.scheduler->promote_linear_attention_checkpoint(seq1, 2);
+    auto stats = fixture.orchestrator->get_linear_attention_snapshot_stats();
+    EXPECT_EQ(stats.num_generation_captured, 1);
+    ASSERT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 2);
+    EXPECT_NO_THROW(fixture.orchestrator->check_linear_attention_row_ownership());
+    // The generation snapshot holds the state of slot 2 (after exactly `boundary` tokens).
+    size_t matching_rows = 0;
+    for (const size_t row : fixture.orchestrator->get_linear_attention_snapshot_rows()) {
+        matching_rows += fixture.row_equals(row, 0x42);
+    }
+    EXPECT_EQ(matching_rows, 1);
+
+    // A pass that crosses no grid boundary captures nothing; the next crossing replaces the snapshot in place.
+    sequence1->append_token(7103, 0.f);
+    group1->set_num_validated_tokens(1);
+    fixture.scheduler->schedule(requests);
+    const size_t before2 = group1->get_num_processed_tokens();
+    group1->finish_iteration();
+    sequence1->append_token(7104, 0.f);
+    fixture.scheduler->capture_linear_attention_generation_snapshot(group1, sequence1, before2,
+                                                                    group1->get_num_processed_tokens());
+    fixture.scheduler->promote_linear_attention_checkpoint(seq1, 2);
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_generation_captured, 1);
+    EXPECT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 2);
+    fixture.finish(group1);
+
+    // Turn 2: previous prompt + accepted generated tokens + new text restarts at the generation snapshot.
+    std::vector<int64_t> prompt2 = prompt1;
+    for (const int64_t token : {7001, 7002, 7102, 7103, 7104, 9001, 9002, 9003}) {
+        prompt2.push_back(token);
+    }
+    auto group2 = make_group(1, prompt2);
+    const uint64_t seq2 = group2->get_running_sequences()[0]->get_id();
+    fixture.scheduler->restore_cached_blocks(group2);
+    EXPECT_EQ(group2->get_num_processed_tokens(), boundary);
+    std::vector<SequenceGroup::Ptr> requests2 = {group2};
+    fixture.scheduler->schedule(requests2);
+    EXPECT_TRUE(fixture.row_equals(fixture.orchestrator->get_linear_attention_live_block(seq2), 0x42));
+    group2->finish_iteration();
+    fixture.finish(group2);
+
+    // A prompt that diverges inside the generated text falls back to the end-of-prompt snapshot.
+    std::vector<int64_t> prompt3 = prompt1;
+    for (const int64_t token : {7001, 5555, 9001, 9002, 9003}) {
+        prompt3.push_back(token);
