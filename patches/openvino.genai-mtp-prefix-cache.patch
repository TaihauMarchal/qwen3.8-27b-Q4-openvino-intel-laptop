+TEST(TestLinearAttentionPrefixSnapshot, capture_and_restore_copy_state_and_skip_prefix) {
+    SnapshotFixture fixture;
+    const size_t bs = fixture.kv_block_size;
+    const size_t grid = 2 * bs;
+
+    // Turn 1: prompt of 2 grid steps + a few tokens -> snapshot at P = 2 * grid.
+    std::vector<int64_t> prompt1 = iota_tokens(2 * grid + 3);
+    auto group1 = make_group(0, prompt1);
+    const uint64_t seq1 = group1->get_running_sequences()[0]->get_id();
+    std::vector<SequenceGroup::Ptr> requests = {group1};
+    while (group1->get_num_processed_tokens() < group1->get_prompt_len()) {
+        const size_t processed = group1->get_num_processed_tokens();
+        if (processed == 2 * grid) {
+            // State "after token P-1" lives in the committed row right before the step that captures it.
+            fixture.fill_row(fixture.orchestrator->get_linear_attention_live_block(seq1), 0xAB);
+        }
+        fixture.scheduler->schedule(requests);
+        if (processed == 2 * grid) {
+            ASSERT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 1);
+            // Simulate the forward pass overwriting the committed row after the copy.
+            fixture.fill_row(fixture.orchestrator->get_linear_attention_live_block(seq1), 0x11);
+        }
+        group1->finish_iteration();
+    }
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_captured, 1);
+    fixture.finish(group1);
+
+    // Turn 2 (append-only): restores exactly P tokens and copies the snapshot into its own row.
+    std::vector<int64_t> prompt2 = prompt1;
+    for (int64_t token : {7, 8, 9, 10, 11}) {
+        prompt2.push_back(token);
+    }
+    auto group2 = make_group(1, prompt2);
+    const uint64_t seq2 = group2->get_running_sequences()[0]->get_id();
+    fixture.scheduler->restore_cached_blocks(group2);
+    EXPECT_EQ(group2->get_num_processed_tokens(), 2 * grid);
+    auto stats = fixture.orchestrator->get_linear_attention_snapshot_stats();
+    EXPECT_EQ(stats.num_restored_requests, 1);
+    EXPECT_EQ(stats.num_restored_tokens, 2 * grid);
+
+    // The restore runs on the add_request thread and must not allocate LA rows: the committed row is only
+    // allocated when the sequence is first scheduled, and the pending copy lands there before the forward.
+    EXPECT_FALSE(fixture.scheduler->has_block_table(seq2) &&
+                 fixture.orchestrator->get_block_manager(CacheType::LINEAR_ATTENTION_CACHE).has_block_table(seq2));
+    const auto snapshot_rows = fixture.orchestrator->get_linear_attention_snapshot_rows();
+    const size_t allocated_rows = fixture.la_tensor().get_shape()[0];
+    for (size_t row = 0; row < allocated_rows; ++row) {
+        if (std::find(snapshot_rows.begin(), snapshot_rows.end(), row) == snapshot_rows.end()) {
+            fixture.fill_row(row, 0x22);
+        }
+    }
+    std::vector<SequenceGroup::Ptr> requests2 = {group2};
+    fixture.scheduler->schedule(requests2);  // allocates the row, applies snapshot -> row before "forward"
+    const size_t row2 = fixture.orchestrator->get_linear_attention_live_block(seq2);
+    EXPECT_TRUE(fixture.row_equals(row2, 0xAB));
+    EXPECT_EQ(group2->get_num_scheduled_tokens(), prompt2.size() - 2 * grid);
+    group2->finish_iteration();
+    fixture.finish(group2);
+
+    // A different prefix must not restore anything.
+    std::vector<int64_t> other = iota_tokens(prompt2.size(), 5);
+    auto group3 = make_group(2, other);
+    fixture.scheduler->restore_cached_blocks(group3);
+    EXPECT_EQ(group3->get_num_processed_tokens(), 0);
+
+    // A restore limit below the snapshot position (MTP draft alignment) disables reuse.
+    auto group4 = make_group(3, prompt2);
+    fixture.scheduler->restore_cached_blocks(group4, 2 * grid - 1);
+    EXPECT_EQ(group4->get_num_processed_tokens(), 0);
+}
