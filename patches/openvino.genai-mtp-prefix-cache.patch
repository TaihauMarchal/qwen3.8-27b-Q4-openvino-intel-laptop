+TEST(TestLinearAttentionPrefixSnapshot, lru_store_respects_capacity_and_freed_sequences_cancel_restores) {
+    SnapshotFixture fixture;
+    const size_t bs = fixture.kv_block_size;
+    const size_t grid = 2 * bs;
+
+    // Three distinct prompts, capacity 1 (default): every new snapshot evicts the previous one.
+    for (uint64_t r = 0; r < 3; ++r) {
+        std::vector<int64_t> prompt = iota_tokens(grid + 2, static_cast<int64_t>(100 * (r + 1)));
+        auto group = make_group(r, prompt);
+        fixture.prefill(group);
+        fixture.finish(group);
+    }
+    auto stats = fixture.orchestrator->get_linear_attention_snapshot_stats();
+    EXPECT_EQ(stats.num_captured, 3);
+    EXPECT_EQ(stats.num_evicted, 2);
+    EXPECT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 1);
+
+    // Restore then free before scheduling: the pending copy must be cancelled (row may be reused).
+    std::vector<int64_t> prompt = iota_tokens(grid + 2, 300);
+    prompt.push_back(1);
+    auto group = make_group(10, prompt);
+    fixture.scheduler->restore_cached_blocks(group);
+    ASSERT_EQ(group->get_num_processed_tokens(), grid);
+    fixture.finish(group);
+    // Every snapshot is unpinned again: three more distinct prompts can cycle through the store.
+    for (uint64_t r = 0; r < 3; ++r) {
+        std::vector<int64_t> p = iota_tokens(grid + 2, static_cast<int64_t>(1000 * (r + 1)));
+        auto g = make_group(20 + r, p);
+        fixture.prefill(g);
+        fixture.finish(g);
+    }
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_captured, 6);
+    EXPECT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 1);
+}
