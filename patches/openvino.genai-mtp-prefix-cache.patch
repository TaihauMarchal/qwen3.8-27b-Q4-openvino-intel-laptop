new file mode 100644
index 0000000..3e189f5
--- /dev/null
+++ b/src/cpp/src/continuous_batching/mtp_prof.hpp
@@ -0,0 +1,88 @@
+// Copyright (C) 2025-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <string>
+
+// Lightweight env-gated wall-clock profiler for the MTP / continuous-batching hot path.
+// OV_GENAI_PROFILE=1 enables it (read once). Scopes accumulate into a global table that is dumped to
+// stderr (and cleared) by prof::dump(); when disabled a scope costs one predictable branch.
+namespace ov::genai::prof {
+
+inline bool enabled() {
+    static const bool value = []() {
+        const char* env = std::getenv("OV_GENAI_PROFILE");
+        return env && *env && *env != '0';
+    }();
+    return value;
+}
+
+struct Entry {
+    double us = 0.0;
+    size_t count = 0;
+};
+
+inline std::map<std::string, Entry>& table() {
+    static std::map<std::string, Entry> value;
+    return value;
+}
+
+inline std::mutex& table_mutex() {
+    static std::mutex value;
+    return value;
+}
+
+inline void add(const char* name, double us, size_t count = 1) {
+    std::lock_guard<std::mutex> lock(table_mutex());
+    auto& entry = table()[name];
+    entry.us += us;
+    entry.count += count;
+}
+
+class Scope {
+public:
+    explicit Scope(const char* name) : m_name(name), m_enabled(enabled()) {
+        if (m_enabled) {
+            m_start = std::chrono::steady_clock::now();
+        }
+    }
+    ~Scope() {
+        if (m_enabled) {
+            const auto end = std::chrono::steady_clock::now();
+            add(m_name, std::chrono::duration<double, std::micro>(end - m_start).count());
+        }
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    const char* m_name;
+    bool m_enabled;
+    std::chrono::steady_clock::time_point m_start;
+};
+
+inline void dump(const char* title) {
+    if (!enabled()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(table_mutex());
+    std::fprintf(stderr, "[prof] %s:", title);
+    for (const auto& [name, entry] : table()) {
+        std::fprintf(stderr, " %s=%.1fms/%zu", name.c_str(), entry.us / 1000.0, entry.count);
+    }
+    std::fprintf(stderr, "\n");
+    std::fflush(stderr);
+    table().clear();
+}
+
+}  // namespace ov::genai::prof
+
+#define OV_GENAI_PROF_CONCAT_(a, b) a##b
+#define OV_GENAI_PROF_CONCAT(a, b) OV_GENAI_PROF_CONCAT_(a, b)
+#define OV_GENAI_PROF_SCOPE(name) ::ov::genai::prof::Scope OV_GENAI_PROF_CONCAT(ov_genai_prof_scope_, __LINE__)(name)
