+TEST(TestLinearAttentionPrefixSnapshot, shared_prefix_is_learned_from_kv_coverage_and_survives_rolling_snapshots) {
+    SnapshotFixture probe;
+    const size_t bs = probe.kv_block_size;
+    ScopedEnv env("OV_GENAI_LA_SHARED_PREFIX_MIN", std::to_string(bs));
+    SnapshotFixture fixture;
+    const size_t grid = 2 * bs;
+    const size_t shared_len = 2 * grid + bs;  // not on the chunk grid: the prefill chunk must be cut there
+    const std::vector<int64_t> shared = iota_tokens(shared_len);
+    auto conversation = [&](int64_t start, size_t extra) {
+        std::vector<int64_t> prompt = shared;
+        for (size_t i = 0; i < extra; ++i) {
+            prompt.push_back(start + static_cast<int64_t>(i));
+        }
+        return prompt;
+    };
+
+    // Conversation A: nothing cached yet, only its own end-of-prompt snapshot is taken.
+    auto prompt_a = conversation(50000, grid + 3);
+    auto group_a = make_group(0, prompt_a);
+    fixture.scheduler->restore_cached_blocks(group_a);
+    EXPECT_EQ(group_a->get_num_processed_tokens(), 0);
+    fixture.prefill(group_a);
+    fixture.finish(group_a);
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_shared_captured, 0);
+
+    // Conversation B shares only the prefix: no snapshot is usable, but the KV cache covers the shared part.
+    // Its prefill ends a chunk at the shared length and snapshots it.
+    auto prompt_b = conversation(60000, grid + 5);
+    auto group_b = make_group(1, prompt_b);
+    fixture.scheduler->restore_cached_blocks(group_b);
+    EXPECT_EQ(group_b->get_num_processed_tokens(), 0);
+    const auto chunks = fixture.prefill(group_b);
+    size_t position = 0;
+    bool chunk_ended_at_shared_len = false;
+    for (const size_t chunk : chunks) {
+        position += chunk;
+        chunk_ended_at_shared_len |= position == shared_len;
+    }
+    EXPECT_TRUE(chunk_ended_at_shared_len);
+    fixture.finish(group_b);
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_shared_captured, 1);
+
+    // Later conversations restart at the shared prefix, however many rolling snapshots were taken since.
+    for (uint64_t r = 0; r < 3; ++r) {
+        auto prompt = conversation(70000 + 1000 * static_cast<int64_t>(r), grid + 2);
+        auto group = make_group(2 + r, prompt);
+        fixture.scheduler->restore_cached_blocks(group);
+        EXPECT_EQ(group->get_num_processed_tokens(), shared_len) << "conversation " << r;
+        fixture.prefill(group);
+        fixture.finish(group);
+    }
+    EXPECT_EQ(fixture.orchestrator->get_linear_attention_snapshot_stats().num_shared_captured, 1);
+    EXPECT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 2);
+}
+
+namespace {
+// A long conversation takes its snapshot, `num_small` unrelated short requests run in between (title / tag /
+// follow-up generation), then the conversation continues. Returns how many prompt tokens its next round re-reads.
+size_t reread_after_interleaved_requests(SnapshotFixture& fixture, size_t num_small) {
+    const size_t grid = 2 * fixture.kv_block_size;
+    std::vector<int64_t> conversation = iota_tokens(8 * grid + 3, 100000);
+    auto round1 = make_group(0, conversation);
+    fixture.prefill(round1);
+    fixture.finish(round1);
+    for (size_t i = 0; i < num_small; ++i) {
+        std::vector<int64_t> small = iota_tokens(2 * grid + 5, 200000 + 10000 * static_cast<int64_t>(i));
+        auto group = make_group(10 + i, small);
+        fixture.scheduler->restore_cached_blocks(group);
+        EXPECT_EQ(group->get_num_processed_tokens(), 0);
+        fixture.prefill(group);
+        fixture.finish(group);
+    }
+    std::vector<int64_t> next_round = conversation;
+    for (int64_t token : {7, 8, 9, 10}) {
+        next_round.push_back(token);
+    }
+    auto round2 = make_group(1, next_round);
+    fixture.scheduler->restore_cached_blocks(round2);
+    const size_t reread = next_round.size() - round2->get_num_processed_tokens();
+    fixture.finish(round2);
+    return reread;
+}
+}  // namespace
+
+TEST(TestLinearAttentionPrefixSnapshot, interleaved_small_requests_do_not_evict_the_conversation_snapshot) {
+    SnapshotFixture probe;
+    const size_t bs = probe.kv_block_size;
+    const size_t grid = 2 * bs;
+    {
+        // Default store (1 snapshot, LRU): one unrelated request is enough to lose the conversation.
+        SnapshotFixture legacy;
+        EXPECT_EQ(reread_after_interleaved_requests(legacy, 1), 8 * grid + 3 + 4);
+    }
+    {
+        // Generation snapshots enabled -> 4 rolling slots and the value-based policy: the conversation's
+        // snapshot survives any number of smaller unrelated requests, which recycle each other's slots.
+        ScopedEnv env("OV_GENAI_LA_GEN_SNAPSHOT_GRID", std::to_string(bs));
+        SnapshotFixture fixture;
+        EXPECT_EQ(reread_after_interleaved_requests(fixture, 6), 3 + 4);
+        EXPECT_LE(fixture.orchestrator->get_num_linear_attention_snapshots(), 4);
+    }
+}
+
+TEST(TestLinearAttentionPrefixSnapshot, value_policy_caps_conversations_recycles_one_shot_requests_and_retires_stale_ones) {
+    SnapshotFixture probe;
+    const size_t bs = probe.kv_block_size;
+    const size_t grid = 2 * bs;
+    ScopedEnv env("OV_GENAI_LA_GEN_SNAPSHOT_GRID", std::to_string(bs));
+    SnapshotFixture fixture;
+    auto run = [&](uint64_t request_id, const std::vector<int64_t>& prompt) {
+        std::vector<int64_t> tokens = prompt;
+        auto group = make_group(request_id, tokens);
+        fixture.scheduler->restore_cached_blocks(group);
+        const size_t restored = group->get_num_processed_tokens();
+        fixture.prefill(group);
+        fixture.finish(group);
+        return restored;
+    };
+    // Big conversation A, then a smaller conversation B: B still gets its own snapshots (A keeps its slot).
+    const std::vector<int64_t> a1 = iota_tokens(8 * grid + 3, 100000);
+    const std::vector<int64_t> b1 = iota_tokens(3 * grid + 3, 300000);
+    EXPECT_EQ(run(0, a1), 0);
+    EXPECT_EQ(run(1, b1), 0);
+    std::vector<int64_t> b2 = b1;
+    b2.push_back(1);
+    EXPECT_EQ(run(2, b2), 3 * grid);
+    std::vector<int64_t> a2 = a1;
+    a2.push_back(1);
+    EXPECT_EQ(run(3, a2), 8 * grid);
+    // A conversation never holds more than 2 of the 4 rolling slots, even while free rows exist: after two more
+    // rounds of B (one new end-of-prompt snapshot each) the store holds A's snapshot and B's two newest ones.
+    std::vector<int64_t> b3 = b2;
+    for (size_t i = 0; i < grid; ++i) {
+        b3.push_back(310000 + static_cast<int64_t>(i));
+    }
+    EXPECT_EQ(run(5, b3), 3 * grid);
+    std::vector<int64_t> b4 = b3;
+    for (size_t i = 0; i < grid; ++i) {
+        b4.push_back(320000 + static_cast<int64_t>(i));
+    }
+    EXPECT_EQ(run(6, b4), 4 * grid);
+    EXPECT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 3);
+    // Many unrelated one-shot requests later (more than the recency window) A and B are stale and get recycled.
+    for (uint64_t r = 0; r < 4; ++r) {
+        EXPECT_EQ(run(100 + r, iota_tokens(2 * grid + 3, 400000 + 10000 * static_cast<int64_t>(r))), 0);
+    }
+    // Within the recency window the short one-shot requests only recycled each other: A is still there.
+    std::vector<int64_t> a3 = a2;
+    a3.push_back(2);
+    EXPECT_EQ(run(4, a3), 8 * grid);
+    for (uint64_t r = 0; r < 14; ++r) {
+        EXPECT_EQ(run(200 + r, iota_tokens(2 * grid + 3, 500000 + 10000 * static_cast<int64_t>(r))), 0);
+    }
+    std::vector<int64_t> a4 = a3;
+    a4.push_back(3);
+    EXPECT_EQ(run(7, a4), 0);
+}
+
+TEST(TestLinearAttentionPrefixSnapshot, invalidate_prefix_cache_forgets_kv_blocks_and_snapshots) {
+    SnapshotFixture fixture;
+    const size_t grid = 2 * fixture.kv_block_size;
+    std::vector<int64_t> prompt1 = iota_tokens(2 * grid + 3);
+    auto group1 = make_group(0, prompt1);
+    fixture.prefill(group1);
+    fixture.finish(group1);
+
+    std::vector<int64_t> prompt2 = prompt1;
+    prompt2.push_back(7);
+    {
+        // Sanity: the continuation would restart from the snapshot.
+        auto group = make_group(1, prompt2);
+        fixture.scheduler->restore_cached_blocks(group);
+        ASSERT_EQ(group->get_num_processed_tokens(), 2 * grid);
+        fixture.finish(group);
+    }
+
+    // The cached state is declared untrustworthy (non-finite logits): nothing may be restored any more.
+    fixture.scheduler->invalidate_prefix_cache();
+    EXPECT_EQ(fixture.scheduler->get_num_prefix_cache_invalidations(), 1);
+    EXPECT_EQ(fixture.orchestrator->get_num_linear_attention_snapshots(), 0);
+    auto& kv = fixture.orchestrator->get_block_manager(CacheType::KV_CACHE);
+    EXPECT_EQ(kv.num_free_blocks(), kv.get_total_block_count());
+    auto group3 = make_group(2, prompt2);
+    fixture.scheduler->restore_cached_blocks(group3);
+    EXPECT_EQ(group3->get_num_processed_tokens(), 0);
+    EXPECT_EQ(kv.get_prefix_restore_plan(group3, prompt2.size() - 1).cache_token_position, 0);
+
+    // The pipeline keeps working: the retried request is prefilled from scratch and caches again.
+    fixture.prefill(group3);
+    fixture.finish(group3);
+    std::vector<int64_t> prompt4 = prompt2;
+    prompt4.push_back(8);
+    auto group4 = make_group(3, prompt4);
+    fixture.scheduler->restore_cached_blocks(group4);
+    EXPECT_EQ(group4->get_num_processed_tokens(), 2 * grid);
+    fixture.finish(group4);
+}
+
+TEST(TestLinearAttentionPrefixSnapshot, prefix_hashes_never_cover_unwritten_prompt_tokens) {
+    // A prefill chunk ending inside a KV block must not register that block under the hash of tokens the
+    // next chunk has not written yet (they would be restored as garbage after a cancel / concurrent restore).
+    const size_t bs = 4;
+    BlockManager kv(16, /*enable_prefix_caching=*/true, bs);
+    std::vector<int64_t> prompt = iota_tokens(10);
+    auto group = make_group(0, prompt);
+    auto sequence = group->get_running_sequences()[0];
+    kv.allocate_tokens(sequence, group, /*num_tokens=*/6, group->get_prompt_len());  // chunk [0, 6)
+    group->schedule_tokens(6);
+
+    std::vector<int64_t> same_prompt = iota_tokens(10);
+    auto other = make_group(1, same_prompt);
+    auto plan = kv.get_prefix_restore_plan(other, 9);
+    ASSERT_FALSE(plan.empty());
+    EXPECT_EQ(plan.cache_token_position, 6);  // not 8: tokens 6 and 7 are not written yet
+    kv.free_sequence(sequence->get_id());
+}
diff --git a/tests/cpp/sampler.cpp b/tests/cpp/sampler.cpp
