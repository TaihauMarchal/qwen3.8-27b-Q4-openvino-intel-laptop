--- a/tests/cpp/sampler.cpp
+++ b/tests/cpp/sampler.cpp
@@ -2,6 +2,7 @@
 // SPDX-License-Identifier: Apache-2.0
 
 #include <gtest/gtest.h>
+#include <limits>
 #include "sampling/sampler.hpp"
 #include "openvino/genai/generation_config.hpp"
 #include "utils.hpp"
@@ -304,3 +305,252 @@ TEST(SamplerValidationMode, prompt_phase) {
              expected{0, 1, 2, 3};
     ASSERT_EQ(sequence_groups.front()->get_sequences().front()->get_generated_ids(), expected);
 }
+
+namespace {
+
+// One verification pass of `candidates` against fixed per-position `logits` rows ((candidates + 1) x vocab)
+// with a deterministic draft; returns the generated ids (first token 0, then the pass result).
+TokenIds verify_pass_with_deterministic_draft(const ov::genai::GenerationConfig& config,
+                                              const std::vector<int64_t>& candidates,
+                                              std::vector<float> logits,
+                                              size_t vocab_size) {
+    std::vector<int64_t> input_vector{0, 1, 2, 3, 4};
+    ov::Tensor input_tensor(ov::element::i64, ov::Shape{1, 5}, input_vector.data());
+    std::vector<SequenceGroup::Ptr> sequence_groups{SequenceGroup::Ptr(new SequenceGroup(0, input_tensor, config))};
+    auto& group = sequence_groups.front();
+    group->get_sequences().front()->append_token(0, 1.f);
+    group->update_processed_tokens_num(5);
+    for (const int64_t candidate : candidates) {
+        group->get_sequences().front()->append_token(candidate, 1.f);
+    }
+    group->set_num_validated_tokens(candidates.size());
+    group->schedule_tokens(group->get_num_available_tokens_for_batching());
+    ov::Tensor logits_tensor(ov::element::f32, ov::Shape{candidates.size() + 1, 1, vocab_size}, logits.data());
+    Sampler sampler;
+    sampler.set_deterministic_draft(true);
+    sampler.sample(sequence_groups, logits_tensor, true);
+    return group->get_sequences().front()->get_generated_ids();
+}
+
+// Plain (non-speculative) sampling of the same positions, one token per step, from the same logits rows.
+TokenIds plain_sampling(const ov::genai::GenerationConfig& config,
+                        std::vector<float> logits,
+                        size_t vocab_size,
+                        size_t num_steps) {
+    std::vector<int64_t> input_vector{0, 1, 2, 3, 4};
+    ov::Tensor input_tensor(ov::element::i64, ov::Shape{1, 5}, input_vector.data());
+    std::vector<SequenceGroup::Ptr> sequence_groups{SequenceGroup::Ptr(new SequenceGroup(0, input_tensor, config))};
+    auto& group = sequence_groups.front();
+    group->get_sequences().front()->append_token(0, 1.f);
+    group->update_processed_tokens_num(5);
+    Sampler sampler;
+    for (size_t step = 0; step < num_steps; ++step) {
+        group->schedule_tokens(1);
+        ov::Tensor row(ov::element::f32, ov::Shape{1, 1, vocab_size}, logits.data() + step * vocab_size);
+        sampler.sample(sequence_groups, row, false);
+    }
+    return group->get_sequences().front()->get_generated_ids();
+}
+
+}  // namespace
+
+// MTP sampling: with a greedy (deterministic) draft the verifier samples its own token at every position and
+// accepts a candidate iff it sampled the same token. For every seed the result must be exactly what plain
+// sampling produces from the same logits: the longest prefix on which the candidates agree with the sampled
+// tokens, followed by the verifier's own token.
+TEST(SamplerValidationMode, deterministic_draft_sampling_matches_plain_sampling_for_every_seed) {
+    constexpr size_t vocab_size = 5;
+    const std::vector<int64_t> candidates = {1, 2, 3};
+    // Candidate probabilities ~0.62, ~0.48 and ~0.84; the remaining mass is spread over the other tokens.
+    const std::vector<float> logits = {
+        0.0f, 2.0f, 0.5f, 0.0f, -1.0f,
+        0.3f, 0.0f, 1.5f, 0.6f, 0.0f,
+        -1.0f, 0.0f, 0.0f, 3.0f, 0.0f,
+        1.0f, 0.2f, 0.0f, 0.4f, 2.0f,
+    };
+    size_t fully_accepted = 0, rejected_at_first = 0;
+    for (size_t seed = 0; seed < 300; ++seed) {
+        auto config = ov::genai::utils::get_greedy_config();
+        config.do_sample = true;
+        config.temperature = 1.0f;
+        config.rng_seed = seed;
+        config.num_assistant_tokens = candidates.size();
+
+        const TokenIds reference = plain_sampling(config, logits, vocab_size, candidates.size() + 1);
+        ASSERT_EQ(reference.size(), candidates.size() + 2);
+        // Expected speculative result: reference tokens up to and including the first disagreement.
+        TokenIds expected{0};
+        size_t accepted = 0;
+        for (size_t i = 0; i <= candidates.size(); ++i) {
+            expected.push_back(reference[i + 1]);
+            if (i == candidates.size() || reference[i + 1] != candidates[i]) {
+                break;
+            }
+            ++accepted;
+        }
+        fully_accepted += accepted == candidates.size();
+        rejected_at_first += accepted == 0;
+        ASSERT_EQ(verify_pass_with_deterministic_draft(config, candidates, logits, vocab_size), expected)
+            << "seed " << seed;
+    }
+    // Both outcomes must actually occur for the comparison above to be meaningful.
+    EXPECT_GT(fully_accepted, 20u);
+    EXPECT_GT(rejected_at_first, 20u);
+}
+
+// Greedy decoding is unaffected by the deterministic-draft flag.
+TEST(SamplerValidationMode, deterministic_draft_flag_keeps_greedy_validation) {
+    constexpr size_t vocab_size = 5;
+    const std::vector<float> logits = {
+        0, 1.f, 0, 0, 0,
+        0, 0, 0, 0, 1.f,
+        0, 0, 0, 1.f, 0,
+        0, 0, 0, 0, 1.f,
+    };
+    auto config = ov::genai::utils::get_greedy_config();
+    config.num_assistant_tokens = 3;
+    // Candidate 2 is rejected at the second position (target argmax is 4).
+    const TokenIds expected{0, 1, 4};
+    EXPECT_EQ(verify_pass_with_deterministic_draft(config, {1, 2, 3}, logits, vocab_size), expected);
+}
+
+namespace {
+
+// One sampling pass over `logits` rows ((candidates + 1) x vocab) with the given sampler; with candidates this is
+// a speculative verification pass (validation mode), without it is plain one-token sampling.
+TokenIds run_pass(Sampler& sampler,
+                  const ov::genai::GenerationConfig& config,
+                  const std::vector<int64_t>& candidates,
+                  std::vector<float> logits,
+                  size_t vocab_size) {
+    std::vector<int64_t> input_vector{0, 1, 2, 3, 4};
+    ov::Tensor input_tensor(ov::element::i64, ov::Shape{1, 5}, input_vector.data());
+    std::vector<SequenceGroup::Ptr> sequence_groups{SequenceGroup::Ptr(new SequenceGroup(0, input_tensor, config))};
+    auto& group = sequence_groups.front();
+    group->get_sequences().front()->append_token(0, 1.f);
+    group->update_processed_tokens_num(5);
+    for (const int64_t candidate : candidates) {
+        group->get_sequences().front()->append_token(candidate, 1.f);
+    }
+    if (!candidates.empty()) {
+        group->set_num_validated_tokens(candidates.size());
+    }
+    group->schedule_tokens(candidates.empty() ? 1 : group->get_num_available_tokens_for_batching());
+    ov::Tensor logits_tensor(ov::element::f32, ov::Shape{candidates.size() + 1, 1, vocab_size}, logits.data());
+    sampler.sample(sequence_groups, logits_tensor, !candidates.empty());
+    return group->get_sequences().front()->get_generated_ids();
+}
+
+ov::genai::GenerationConfig sampling_config(size_t seed = 7) {
+    auto config = ov::genai::utils::get_greedy_config();
+    config.do_sample = true;
+    config.temperature = 0.6f;
+    config.top_p = 0.95f;
+    config.top_k = 20;
+    config.rng_seed = seed;
+    return config;
+}
+
+const float kNaN = std::numeric_limits<float>::quiet_NaN();
+const float kInf = std::numeric_limits<float>::infinity();
+
+}  // namespace
+
+TEST(SamplerNonFiniteLogits, is_finite_row_detects_nan_and_infinities_anywhere) {
+    std::vector<float> row(1000, 1.5f);
+    EXPECT_TRUE(Sampler::is_finite_row(row.data(), row.size()));
+    for (const float bad : {kNaN, kInf, -kInf}) {
+        for (const size_t position : {size_t(0), size_t(499), size_t(999)}) {
+            auto copy = row;
+            copy[position] = bad;
+            EXPECT_FALSE(Sampler::is_finite_row(copy.data(), copy.size())) << "value " << bad << " at " << position;
+        }
+    }
+    row.assign(1000, -std::numeric_limits<float>::max());
+    EXPECT_TRUE(Sampler::is_finite_row(row.data(), row.size()));
+}
+
+// MTP verification, greedy: a NaN row that is used aborts the pass with a dedicated error (and no token of the
+// pass survives in what the caller can read); a NaN row behind the first rejected candidate is never read.
+TEST(SamplerNonFiniteLogits, greedy_verification_throws_on_used_rows_only) {
+    constexpr size_t vocab_size = 5;
+    auto config = ov::genai::utils::get_greedy_config();
+    config.num_assistant_tokens = 3;
+    config.presence_penalty = 0.5f;
+    // candidates {1, 2, 3}: row 0 accepts 1, row 1 accepts 2, row 2 is NaN.
+    std::vector<float> logits = {
+        0, 1.f, 0, 0, 0,
+        0, 0, 1.f, 0, 0,
+        kNaN, kNaN, kNaN, kNaN, kNaN,
+        0, 0, 0, 0, 1.f,
+    };
+    const size_t events_before = Sampler::get_non_finite_logits_count();
+    {
+        Sampler sampler;
+        sampler.set_deterministic_draft(true);
+        try {
+            run_pass(sampler, config, {1, 2, 3}, logits, vocab_size);
+            FAIL() << "non-finite logits must abort the pass";
+        } catch (const NonFiniteLogitsError& error) {
+            EXPECT_NE(std::string(error.what()).find(NON_FINITE_LOGITS_MARKER), std::string::npos) << error.what();
+            EXPECT_NE(std::string(error.what()).find("token position 8"), std::string::npos) << error.what();
+        }
+    }
+    EXPECT_EQ(Sampler::get_non_finite_logits_count(), events_before + 1);
+
+    // Candidate 2 is rejected by row 1 (argmax 4): rows 2 and 3 are not read, their NaN is harmless.
+    logits = {
+        0, 1.f, 0, 0, 0,
+        0, 0, 0, 0, 1.f,
+        kNaN, kNaN, kNaN, kNaN, kNaN,
+        kNaN, kNaN, kNaN, kNaN, kNaN,
+    };
+    Sampler sampler;
+    sampler.set_deterministic_draft(true);
+    const TokenIds expected{0, 1, 4};
+    EXPECT_EQ(run_pass(sampler, config, {1, 2, 3}, logits, vocab_size), expected);
+    EXPECT_EQ(Sampler::get_non_finite_logits_count(), events_before + 1);
+}
+
+TEST(SamplerNonFiniteLogits, sampling_verification_throws) {
+    constexpr size_t vocab_size = 5;
+    auto config = sampling_config();
+    config.num_assistant_tokens = 2;
+    // A single Inf among finite values is enough.
+    const std::vector<float> logits = {
+        0.1f, 2.f, 0.3f, kInf, 0,
+        0, 0, 1.f, 0, 0,
+        0, 0, 0, 1.f, 0,
+    };
+    Sampler sampler;
+    sampler.set_deterministic_draft(true);
+    EXPECT_THROW(run_pass(sampler, config, {1, 2}, logits, vocab_size), NonFiniteLogitsError);
+}
+
+// Plain continuous batching (no draft model): greedy and multinomial.
+TEST(SamplerNonFiniteLogits, plain_greedy_and_sampling_throw) {
+    constexpr size_t vocab_size = 5;
+    const std::vector<float> nan_row = {0, 1.f, kNaN, 0, 0};
+    const std::vector<float> all_nan_row(vocab_size, kNaN);
+    for (const auto& row : {nan_row, all_nan_row}) {
+        Sampler greedy;
+        EXPECT_THROW(run_pass(greedy, ov::genai::utils::get_greedy_config(), {}, row, vocab_size), NonFiniteLogitsError);
+        Sampler multinomial;
+        EXPECT_THROW(run_pass(multinomial, sampling_config(), {}, row, vocab_size), NonFiniteLogitsError);
+    }
+    // Finite rows are unaffected.
+    Sampler greedy;
+    const TokenIds expected{0, 1};
+    EXPECT_EQ(run_pass(greedy, ov::genai::utils::get_greedy_config(), {}, {0, 1.f, 0.5f, 0, 0}, vocab_size), expected);
+}
+
+// The draft model's sampler does not check (a bad draft only costs acceptance): without the check an all-NaN
+// row silently yields token 0, which is exactly the failure the check exists for.
+TEST(SamplerNonFiniteLogits, check_can_be_switched_off_for_draft_samplers) {
+    constexpr size_t vocab_size = 5;
+    Sampler sampler;
+    sampler.set_check_finite_logits(false);
+    const TokenIds expected{0, 0};
+    EXPECT_EQ(run_pass(sampler, ov::genai::utils::get_greedy_config(), {}, std::vector<float>(vocab_size, kNaN), vocab_size),
+              expected);
+}
