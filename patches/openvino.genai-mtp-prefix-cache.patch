+TEST(TestSequencePrefixHashes, remove_last_tokens_drops_hashes_of_removed_blocks) {
+    const size_t block_size = 4;
+    std::vector<int64_t> prompt = iota_tokens(6);
+    auto group = make_group(0, prompt);
+    auto sequence = group->get_running_sequences()[0];
+    for (int64_t token : {1, 2, 3, 4, 5, 6}) {
+        sequence->append_token(token, 0.f);
+    }
+    // Hash the full 12-token content: memoizes blocks [0,4), [0,8), [0,12).
+    const size_t hash_8 = sequence->get_hash(8, block_size);
+    const size_t hash_12_before = sequence->get_hash(12, block_size);
+
+    // Reject the last 3 generated tokens and accept different ones (speculative decoding).
+    sequence->remove_last_tokens(3);
+    for (int64_t token : {40, 50, 60}) {
+        sequence->append_token(token, 0.f);
+    }
+    // Block [8,12) now holds different tokens: its hash must be recomputed, the untouched prefix must not change.
+    EXPECT_EQ(sequence->get_hash(8, block_size), hash_8);
+    EXPECT_NE(sequence->get_hash(12, block_size), hash_12_before);
+
+    // Same content as a fresh sequence -> same hash.
+    std::vector<int64_t> reference_prompt = iota_tokens(6);
+    auto reference_group = make_group(1, reference_prompt);
+    auto reference = reference_group->get_running_sequences()[0];
+    for (int64_t token : {1, 2, 3, 40, 50, 60}) {
+        reference->append_token(token, 0.f);
+    }
+    EXPECT_EQ(sequence->get_hash(12, block_size), reference->get_hash(12, block_size));
+}
