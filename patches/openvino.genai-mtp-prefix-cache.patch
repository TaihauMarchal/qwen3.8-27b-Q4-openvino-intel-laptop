+                                           greedy_config());
+}
+
+std::vector<int64_t> iota_tokens(size_t count, int64_t start = 1000) {
+    std::vector<int64_t> tokens(count);
+    std::iota(tokens.begin(), tokens.end(), start);
+    return tokens;
+}
+
+struct SnapshotFixture {
