+namespace {
+bool all_bytes_equal(const ov::Tensor& tensor, uint8_t value) {
+    const auto* data = static_cast<const uint8_t*>(tensor.data());
+    for (size_t i = 0; i < tensor.get_byte_size(); ++i) {
+        if (data[i] != value) {
+            return false;
+        }
+    }
+    return true;
+}
+}  // namespace
+
+// OV_GENAI_KV_CACHE_INIT controls the content of new KV cache storage (default: left as allocated);
+// reinitialize_contents() always rewrites the whole storage after a poisoned request.
+TEST(TestCacheManager, new_storage_is_initialized_and_can_be_reinitialized) {
+    ov::Core core;
+    const size_t num_decoder_layers = 2;
+    // Explicit CPU: the device-less compile_model() of the older tests goes through AUTO, which intermittently
+    // answers "Not Implemented" while another process uses the GPU.
+    ov::InferRequest request = core.compile_model(get_dummy_model(core, num_decoder_layers), "CPU").create_infer_request();
+    {
+        // Default mode: no fill at allocation, but a poisoned cache is rewritten with zeros.
+        auto cache_manager = std::make_shared<KVCacheManager>(request);
+        cache_manager->allocate_cache_if_needed(4);
+        std::memset(cache_manager->get_key_cache(0).data(), 0xAB, cache_manager->get_key_cache(0).get_byte_size());
+        std::memset(cache_manager->get_value_cache(1).data(), 0xCD, cache_manager->get_value_cache(1).get_byte_size());
+        cache_manager->reinitialize_contents();
+        EXPECT_TRUE(all_bytes_equal(cache_manager->get_key_cache(0), 0));
+        EXPECT_TRUE(all_bytes_equal(cache_manager->get_value_cache(1), 0));
+    }
+    {
+        setenv("OV_GENAI_KV_CACHE_INIT", "zero", 1);
+        auto cache_manager = std::make_shared<KVCacheManager>(request);
+        cache_manager->allocate_cache_if_needed(8);
+        ov::Tensor key_cache = cache_manager->get_key_cache(0);
+        ov::Tensor value_cache = cache_manager->get_value_cache(1);
+        ASSERT_GT(key_cache.get_byte_size(), 0u);
+        EXPECT_TRUE(all_bytes_equal(key_cache, 0));
+        EXPECT_TRUE(all_bytes_equal(value_cache, 0));
+
+        std::memset(key_cache.data(), 0xAB, key_cache.get_byte_size());
+        std::memset(value_cache.data(), 0xCD, value_cache.get_byte_size());
+        cache_manager->reinitialize_contents();
+        EXPECT_TRUE(all_bytes_equal(cache_manager->get_key_cache(0), 0));
+        EXPECT_TRUE(all_bytes_equal(cache_manager->get_value_cache(1), 0));
+
+        // Growing keeps the existing blocks and zero-fills the new ones.
+        std::memset(cache_manager->get_key_cache(0).data(), 0x11, cache_manager->get_key_cache(0).get_byte_size());
+        const size_t old_bytes = cache_manager->get_key_cache(0).get_byte_size();
+        cache_manager->allocate_cache_if_needed(16);
+        ov::Tensor grown = cache_manager->get_key_cache(0);
+        ASSERT_EQ(grown.get_byte_size(), 2 * old_bytes);
+        const auto* data = static_cast<const uint8_t*>(grown.data());
+        EXPECT_EQ(data[0], 0x11);
+        EXPECT_EQ(data[old_bytes - 1], 0x11);
+        EXPECT_EQ(data[old_bytes], 0);
+        EXPECT_EQ(data[2 * old_bytes - 1], 0);
+        unsetenv("OV_GENAI_KV_CACHE_INIT");
+    }
+    {
+        // Debug fill pattern.
+        setenv("OV_GENAI_KV_CACHE_INIT", "ff", 1);
+        auto cache_manager = std::make_shared<KVCacheManager>(request);
+        cache_manager->allocate_cache_if_needed(4);
+        EXPECT_TRUE(all_bytes_equal(cache_manager->get_key_cache(0), 0xFF));
+        unsetenv("OV_GENAI_KV_CACHE_INIT");
+    }
+}
