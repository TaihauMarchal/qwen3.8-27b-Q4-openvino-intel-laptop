+// Softmax probability of token `index` over the (already processed) logits. Terms more than 30 below the
+// selected logit contribute < 1e-13 each and are skipped, so only a handful of expf calls are needed.
+float top1_probability(const Logits& logits, int64_t index) {
+    const bool use_vector = logits.is_vector_initialized();
+    float selected = -std::numeric_limits<float>::infinity();
+    if (use_vector) {
+        for (size_t i = 0; i < logits.m_size; ++i) {
+            if (logits.m_vector[i].m_index == index) {
+                selected = logits.m_vector[i].m_log_prob;
+                break;
+            }
+        }
+    } else if (index >= 0 && static_cast<size_t>(index) < logits.m_size) {
+        selected = logits.m_data[index];
+    }
+    if (!std::isfinite(selected)) {
+        return 0.0f;
+    }
+    const float floor_value = selected - 30.0f;
+    double sum = 0.0;
+    for (size_t i = 0; i < logits.m_size; ++i) {
+        const float value = use_vector ? logits.m_vector[i].m_log_prob : logits.m_data[i];
+        if (value > floor_value) {
+            sum += std::exp(static_cast<double>(value - selected));
+        }
+    }
+    return sum > 0.0 ? static_cast<float>(1.0 / sum) : 0.0f;
+}
