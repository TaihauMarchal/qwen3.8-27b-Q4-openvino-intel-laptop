+
+    ov::Tensor la_tensor() {
+        return request.get_tensor("conv_state_table.0");
+    }
+
+    size_t row_bytes() {
+        auto tensor = la_tensor();
+        return tensor.get_byte_size() / tensor.get_shape()[0];
+    }
+
+    void fill_row(size_t row, uint8_t value) {
+        std::memset(static_cast<uint8_t*>(la_tensor().data()) + row * row_bytes(), value, row_bytes());
+    }
+
+    bool row_equals(size_t row, uint8_t value) {
+        const uint8_t* data = static_cast<const uint8_t*>(la_tensor().data()) + row * row_bytes();
+        for (size_t i = 0; i < row_bytes(); ++i) {
+            if (data[i] != value) {
+                return false;
+            }
+        }
+        return true;
+    }
+};
