+        request = core.compile_model(get_dummy_hybrid_model(core, 1, 1)).create_infer_request();
+        kv_block_size = KVCacheManager(request).get_block_size();
+        config.enable_prefix_caching = true;
+        config.dynamic_split_fuse = true;
+        config.num_kv_blocks = 64;
+        config.max_num_seqs = max_num_seqs;
