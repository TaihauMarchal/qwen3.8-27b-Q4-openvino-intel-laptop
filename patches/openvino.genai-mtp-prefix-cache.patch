+void apply_mtp_draft_vocab_subset(const std::shared_ptr<ov::Model>& mtp_model) {
+    const char* path = std::getenv("OV_MTP_DRAFT_VOCAB");
+    if (!path || !*path) {
+        return;
+    }
+    std::vector<int64_t> ids;
+    {
+        std::ifstream f(path);
+        OPENVINO_ASSERT(f.good(), "OV_MTP_DRAFT_VOCAB: cannot open ", path);
+        int64_t v;
+        while (f >> v) ids.push_back(v);
+    }
+    OPENVINO_ASSERT(!ids.empty(), "OV_MTP_DRAFT_VOCAB: empty id list");
+
+    const auto logits_src = find_result_source(mtp_model, "logits");
+    auto matmul = ov::as_type_ptr<ov::op::v0::MatMul>(logits_src.get_node_shared_ptr());
+    OPENVINO_ASSERT(matmul && matmul->get_transpose_b(), "OV_MTP_DRAFT_VOCAB: expected logits = MatMul(x, W^T)");
+    const auto wshape = matmul->get_input_partial_shape(1);
+    OPENVINO_ASSERT(wshape.rank().get_length() == 2 && wshape[0].is_static(), "OV_MTP_DRAFT_VOCAB: unexpected weight shape");
+    const size_t V = wshape[0].get_length();
+    for (auto id : ids) OPENVINO_ASSERT(id >= 0 && static_cast<size_t>(id) < V, "OV_MTP_DRAFT_VOCAB: id out of range ", id);
+    const size_t N = ids.size();
+
+    // Slice every vocab-major constant feeding the weight input (int weight, zero point, scale).
+    std::vector<std::shared_ptr<ov::Node>> stack{matmul->get_input_node_shared_ptr(1)};
+    std::unordered_map<ov::Node*, bool> seen;
+    size_t sliced = 0;
+    while (!stack.empty()) {
+        auto node = stack.back();
+        stack.pop_back();
+        if (seen[node.get()]) continue;
+        seen[node.get()] = true;
+        if (auto c = ov::as_type_ptr<ov::op::v0::Constant>(node)) {
+            const auto& shp = c->get_shape();
+            if (shp.size() >= 1 && shp[0] == V) {
+                const size_t row_elems = ov::shape_size(shp) / V;
+                const size_t bits = c->get_element_type().bitwidth();
+                OPENVINO_ASSERT((row_elems * bits) % 8 == 0, "OV_MTP_DRAFT_VOCAB: row not byte aligned");
+                const size_t row_bytes = row_elems * bits / 8;
+                auto new_shape = shp;
+                new_shape[0] = N;
+                auto nc = std::make_shared<ov::op::v0::Constant>(c->get_element_type(), new_shape);
+                auto* dst = static_cast<uint8_t*>(const_cast<void*>(nc->get_data_ptr()));
+                const auto* src = static_cast<const uint8_t*>(c->get_data_ptr());
+                for (size_t r = 0; r < N; ++r) std::memcpy(dst + r * row_bytes, src + ids[r] * row_bytes, row_bytes);
+                nc->set_friendly_name(c->get_friendly_name() + "_vocab_subset");
+                ov::replace_node(c, nc);
+                ++sliced;
+            }
+            continue;
+        }
+        for (size_t i = 0; i < node->get_input_size(); ++i) stack.push_back(node->get_input_node_shared_ptr(i));
+    }
+    OPENVINO_ASSERT(sliced > 0, "OV_MTP_DRAFT_VOCAB: no vocab-major constant found under the draft lm_head");
+    mtp_model->validate_nodes_and_infer_types();
+
+    // logits_full = ScatterUpdate(Broadcast(low, shape(mm)[:-1] ++ [V]), ids, mm, axis=-1)
+    auto users = matmul->output(0).get_target_inputs();  // before adding ShapeOf/Scatter consumers
+    const auto et = matmul->get_output_element_type(0);
+    const int64_t rank = matmul->get_output_partial_shape(0).rank().get_length();
+    auto shp = std::make_shared<ov::op::v3::ShapeOf>(matmul, ov::element::i64);
+    auto lead = std::make_shared<ov::op::v8::Slice>(shp,
+        ov::op::v0::Constant::create(ov::element::i64, {1}, {0}), ov::op::v0::Constant::create(ov::element::i64, {1}, {-1}),
+        ov::op::v0::Constant::create(ov::element::i64, {1}, {1}), ov::op::v0::Constant::create(ov::element::i64, {1}, {0}));
+    auto target = std::make_shared<ov::op::v0::Concat>(
+        ov::OutputVector{lead, ov::op::v0::Constant::create(ov::element::i64, {1}, {static_cast<int64_t>(V)})}, 0);
+    auto low = ov::op::v0::Constant::create(et, {}, {-60000.0f});
+    auto base = std::make_shared<ov::op::v3::Broadcast>(low, target);
+    auto idx = ov::op::v0::Constant::create(ov::element::i32, {N}, std::vector<int32_t>(ids.begin(), ids.end()));
+    auto axis = ov::op::v0::Constant::create(ov::element::i64, {}, {rank - 1});
+    auto scatter = std::make_shared<ov::op::v3::ScatterUpdate>(base, idx, matmul, axis);
+    scatter->set_friendly_name("mtp_lm_head_vocab_scatter");
+    for (auto& in : users) in.replace_source_output(scatter);
+    mtp_model->validate_nodes_and_infer_types();
+    std::cerr << "[perf-sweep] MTP draft lm_head restricted to " << N << " of " << V << " tokens (" << sliced
+              << " constants sliced)" << std::endl;
+}
