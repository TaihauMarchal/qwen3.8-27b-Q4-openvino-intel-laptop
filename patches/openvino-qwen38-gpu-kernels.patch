+++ b/src/plugins/intel_gpu/src/kernel_selector/kernels/permute/permute_kernel_f_y_swap_dyn.cpp
@@ -0,0 +1,98 @@
+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#include "permute_kernel_f_y_swap_dyn.h"
+
+#include "common_tools.h"
+#include "kernel_selector_utils.h"
+
+namespace kernel_selector {
+
+namespace {
+constexpr size_t kWgDim = 16;
+constexpr size_t kTileSize = 32;  // 2x2 elements per work-item
+
+bool IsFYSwapOrder(const std::vector<uint16_t>& order) {
+    return order.size() == 4 && order[0] == 0 && order[1] == 3 && order[2] == 2 && order[3] == 1;
+}
+}  // namespace
+
+ParamsKey PermuteKernel_f_y_swap_dyn::GetSupportedKey() const {
+    ParamsKey k;
+    k.EnableInputDataType(Datatype::F16);
+    k.EnableInputDataType(Datatype::BF16);
+    k.EnableInputDataType(Datatype::F32);
+    k.EnableInputDataType(Datatype::INT8);
+    k.EnableInputDataType(Datatype::UINT8);
+    k.EnableInputDataType(Datatype::INT32);
+    k.EnableOutputDataType(Datatype::F16);
+    k.EnableOutputDataType(Datatype::BF16);
+    k.EnableOutputDataType(Datatype::F32);
+    k.EnableOutputDataType(Datatype::INT8);
+    k.EnableOutputDataType(Datatype::UINT8);
+    k.EnableOutputDataType(Datatype::INT32);
+    k.EnableDifferentTypes();
+    k.EnableInputLayout(DataLayout::bfyx);
+    k.EnableOutputLayout(DataLayout::bfyx);
+    k.EnableTensorOffset();
+    k.EnableTensorPitches();
+    k.EnableBatching();
+    k.EnableDynamicShapesSupport();
+    return k;
+}
+
+JitConstants PermuteKernel_f_y_swap_dyn::GetJitConstants(const permute_params& params, const CommonDispatchData& dispatchData) const {
+    auto jit = Parent::GetJitConstants(params, dispatchData);
+    jit.AddConstant(MakeJitConstant("TILE_SIZE", kTileSize));
+    jit.AddConstant(MakeJitConstant("WG_DIM", kWgDim));
+    jit.AddConstant(MakeJitConstant("ELEMS_PER_DIM", kTileSize / kWgDim));
+    if (!params.fused_ops.empty()) {
+        const std::vector<std::string> idx_order = {"b", "out_f", "out_y", "out_x"};
+        const FusedOpsConfiguration conf = {"", idx_order, "val", params.inputs[0].GetDType(), 1};
+        jit.Merge(MakeFusedOpsJitConstants(params, {conf}));
+    }
+    return jit;
+}
+
+CommonDispatchData PermuteKernel_f_y_swap_dyn::SetDefault(const permute_params& params) const {
+    CommonDispatchData dispatchData;
+    const auto& in = params.inputs[0];
+    dispatchData.gws = {CeilDiv(in.Y().v, kTileSize) * kWgDim, CeilDiv(in.Feature().v, kTileSize) * kWgDim, in.Batch().v};
+    dispatchData.lws = {kWgDim, kWgDim, 1};
+    return dispatchData;
+}
+
+bool PermuteKernel_f_y_swap_dyn::Validate(const Params& p) const {
+    if (!Parent::Validate(p)) {
+        DO_NOT_USE_THIS_KERNEL(p.layerID);
+    }
+    const auto& params = static_cast<const permute_params&>(p);
+    const auto& in = params.inputs[0];
+    const auto& out = params.outputs[0];
+    if (!IsFYSwapOrder(params.order)) {
+        DO_NOT_USE_THIS_KERNEL(p.layerID);
+    }
+    if (in.GetLayout() != DataLayout::bfyx || out.GetLayout() != DataLayout::bfyx) {
+        DO_NOT_USE_THIS_KERNEL(p.layerID);
+    }
+    // X must be statically 1 (always true for 3D tensors), so the swap is a pure 2D transpose per batch.
+    if (in.X().is_dynamic || in.X().v != 1 || out.X().is_dynamic || out.X().v != 1) {
+        DO_NOT_USE_THIS_KERNEL(p.layerID);
+    }
+    // Static shapes keep using the existing kernels (permute_f_y_axes / tile kernels / ref).
+    if (!params.has_dynamic_tensors()) {
+        DO_NOT_USE_THIS_KERNEL(p.layerID);
+    }
+    // Padded tensors are left to permute_ref.
+    if (in.has_dynamic_pad() || out.has_dynamic_pad()) {
+        DO_NOT_USE_THIS_KERNEL(p.layerID);
+    }
+    return true;
+}
+
+KernelsPriority PermuteKernel_f_y_swap_dyn::GetKernelsPriority(const Params& /*params*/) const {
+    return FORCE_PRIORITY_2;
+}
+
+}  // namespace kernel_selector
