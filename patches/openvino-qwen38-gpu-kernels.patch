diff --git a/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/permute_f_y_swap_dyn.cl b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/permute_f_y_swap_dyn.cl
new file mode 100644
index 00000000..bd348bdb
--- /dev/null
+++ b/src/plugins/intel_gpu/src/kernel_selector/cl_kernels/permute_f_y_swap_dyn.cl
@@ -0,0 +1,74 @@
+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#include "include/batch_headers/fetch_data.cl"
+
+// Shape-agnostic (dynamic) Transpose that swaps feature and Y with X == 1, i.e. OV order {0,2,1} on 3D tensors
+// (or {0,2,1,3} on 4D tensors with last dim 1):
+//   out[b, f_out = y, y_out = f, 0] = in[b, f, y, 0]
+// Typical use: the [B,T,C] <-> [B,C,T] transposes around the causal conv1d of linear-attention (GatedDeltaNet)
+// blocks, where permute_ref writes with stride T (uncoalesced) and dominated the prefill time.
+//
+// A (WG_DIM x WG_DIM) work-group transposes a TILE_SIZE x TILE_SIZE block through SLM; every work-item
+// handles ELEMS_PER_DIM^2 elements. Reads are coalesced along input Y (innermost), writes along output Y
+// (innermost). Ragged edges are always guarded (shapes are only known at runtime).
+//
+// GWS: (ceil(INPUT0_SIZE_Y / TILE_SIZE) * WG_DIM, ceil(INPUT0_FEATURE_NUM / TILE_SIZE) * WG_DIM, INPUT0_BATCH_NUM)
+
+__attribute__((reqd_work_group_size(WG_DIM, WG_DIM, 1)))
+KERNEL(permute_f_y_swap_dyn)(
+    OPTIONAL_SHAPE_INFO_ARG
+    const __global INPUT0_TYPE* input,
+    __global OUTPUT_TYPE* output
+#if HAS_FUSED_OPS_DECLS
+    , FUSED_OPS_DECLS
+#endif
+)
+{
+    const uint lx = (uint)get_local_id(0);
+    const uint ly = (uint)get_local_id(1);
+    const uint ty = (uint)get_group_id(0);   // tile index along input Y
+    const uint tf = (uint)get_group_id(1);   // tile index along input F
+    const uint b  = (uint)get_global_id(2);
+
+    __local INPUT0_TYPE tile[TILE_SIZE][TILE_SIZE + 1];
+
+    // Phase 1: coalesced reads along input Y. tile[f_local][y_local]
+    __attribute__((opencl_unroll_hint))
+    for (uint df = 0; df < ELEMS_PER_DIM; ++df) {
+        const uint sub_f = ly + df * WG_DIM;
+        const uint in_f = tf * TILE_SIZE + sub_f;
+        __attribute__((opencl_unroll_hint))
+        for (uint dy = 0; dy < ELEMS_PER_DIM; ++dy) {
+            const uint sub_y = lx + dy * WG_DIM;
+            const uint in_y = ty * TILE_SIZE + sub_y;
+            if (in_f < INPUT0_FEATURE_NUM && in_y < INPUT0_SIZE_Y)
+                tile[sub_f][sub_y] = input[INPUT0_GET_INDEX(b, in_f, in_y, 0)];
+        }
+    }
+
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    // Phase 2: coalesced writes along output Y (= input F). Output tile origin: f_out = ty*TILE, y_out = tf*TILE.
+    __attribute__((opencl_unroll_hint))
+    for (uint dfo = 0; dfo < ELEMS_PER_DIM; ++dfo) {
+        const uint sub_fo = ly + dfo * WG_DIM;
+        const uint out_f = ty * TILE_SIZE + sub_fo;
+        __attribute__((opencl_unroll_hint))
+        for (uint dyo = 0; dyo < ELEMS_PER_DIM; ++dyo) {
+            const uint sub_yo = lx + dyo * WG_DIM;
+            const uint out_y = tf * TILE_SIZE + sub_yo;
+            if (out_f >= OUTPUT_FEATURE_NUM || out_y >= OUTPUT_SIZE_Y)
+                continue;
+            const INPUT0_TYPE val = tile[sub_yo][sub_fo];
+            const uint out_x = 0;
+#if HAS_FUSED_OPS
+            FUSED_OPS;
+            output[OUTPUT_GET_INDEX(b, out_f, out_y, out_x)] = FUSED_OPS_RESULT;
+#else
+            output[OUTPUT_GET_INDEX(b, out_f, out_y, out_x)] = TO_OUTPUT_TYPE(ACTIVATION(DECODE_INPUT0_COMPUTE_TYPE(val), ACTIVATION_PARAMS));
+#endif
+        }
+    }
+}
