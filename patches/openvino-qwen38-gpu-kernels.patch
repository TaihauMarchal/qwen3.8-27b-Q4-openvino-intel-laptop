+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#pragma once
+
+#include "permute_kernel_base.h"
+
+namespace kernel_selector {
+
+// Shape-agnostic SLM-tiled Transpose swapping feature and Y when X == 1.
+// Pattern (cldnn order): {0, 3, 2, 1}  <=  OV order {0, 2, 1} (3D) or {0, 2, 1, 3} (4D, last dim 1).
+// Replaces permute_ref (uncoalesced writes) for the dynamic [B,T,C] <-> [B,C,T] transposes of the
+// causal conv1d in linear-attention (Qwen3.5/3.8 GatedDeltaNet) layers; permute_f_y_axes only handles static shapes.
+class PermuteKernel_f_y_swap_dyn : public PermuteKernelBase {
+public:
+    using Parent = PermuteKernelBase;
+    using Parent::Parent;
+    PermuteKernel_f_y_swap_dyn() : PermuteKernelBase("permute_f_y_swap_dyn") {}
+    ~PermuteKernel_f_y_swap_dyn() override = default;
+
+    bool Validate(const Params& p) const override;
+    KernelsPriority GetKernelsPriority(const Params& params) const override;
+    ParamsKey GetSupportedKey() const override;
+
+protected:
+    JitConstants GetJitConstants(const permute_params& params, const CommonDispatchData& dispatchData) const override;
+    CommonDispatchData SetDefault(const permute_params& params) const override;
+    std::vector<FusedOpType> GetSupportedFusedOps() const override {
+        return {FusedOpType::REORDER, FusedOpType::ACTIVATION, FusedOpType::QUANTIZE, FusedOpType::ELTWISE};
+    }
+};
+
+}  // namespace kernel_selector
