+// [backport-long-ctx] Local equivalent of upstream "Prefetch constants during model compilation" (#38993, #39493),
+// whose core-side API (ov::util::OrderedPrefetchScheduler) does not exist in the 2026.4.1 runtime this plugin is
+// loaded into. Large constants are copied from the mmap-ed (usually not yet resident) model file into GPU memory by
+// several threads, so the page-in of the source and the first touch of the destination are not serialized on one thread.
+// OV_GPU_CONST_COPY_THREADS=N overrides the thread count (0 or 1 restores the single-threaded memcpy).
+static size_t const_copy_threads() {
+    static const size_t value = [] {
+        if (const char* env = std::getenv("OV_GPU_CONST_COPY_THREADS")) {
+            return static_cast<size_t>(std::max(0l, std::strtol(env, nullptr, 10)));
+        }
+        const size_t hw = std::thread::hardware_concurrency();
+        return std::min<size_t>(8, std::max<size_t>(1, hw / 2));
+    }();
+    return value;
+}
+
+static void copy_constant_data(char* dst, const char* src, size_t size) {
+    // 1 MiB per thread at least: most compressed FC weights of an LLM are 10-50 MiB each.
+    constexpr size_t min_chunk = size_t{1} << 20;
+    const size_t threads = std::min(const_copy_threads(), size / min_chunk);
+    if (threads <= 1) {
+        std::memcpy(dst, src, size);
+        return;
+    }
+    const size_t chunk = ((size / threads) + 4095) & ~size_t{4095};
+    std::vector<std::thread> workers;
+    workers.reserve(threads);
+    for (size_t offset = chunk; offset < size; offset += chunk) {
+        const size_t len = std::min(chunk, size - offset);
+        try {
+            workers.emplace_back([=] {
+                std::memcpy(dst + offset, src + offset, len);
+            });
+        } catch (const std::system_error&) {
+            std::memcpy(dst + offset, src + offset, len);
+        }
+    }
+    std::memcpy(dst, src, std::min(chunk, size));
+    for (auto& worker : workers) {
+        worker.join();
+    }
+}
